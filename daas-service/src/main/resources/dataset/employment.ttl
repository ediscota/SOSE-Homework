@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix schema: <http://schema.org/> .
@prefix emp:    <http://sose.univaq.it/employment#> .

#################################################################
# Lightweight ontology
#################################################################
emp:Candidate     a rdfs:Class ; rdfs:subClassOf foaf:Person ;
                  rdfs:label "Candidate"@en .
emp:JobOffer      a rdfs:Class ; rdfs:label "Job offer"@en .
emp:Company       a rdfs:Class ; rdfs:subClassOf schema:Organization ;
                  rdfs:label "Company"@en .
emp:Skill         a rdfs:Class ; rdfs:label "Skill"@en .
emp:Sector        a rdfs:Class ; rdfs:label "Sector"@en .
emp:Location      a rdfs:Class ; rdfs:label "Location"@en .

emp:hasSkill            a rdf:Property .
emp:hasSector           a rdf:Property .
emp:hasLocation         a rdf:Property .
emp:postedBy            a rdf:Property .
emp:yearsOfExperience   a rdf:Property .
emp:requiredExperience  a rdf:Property .
emp:salary              a rdf:Property .
emp:minSalary           a rdf:Property .
emp:postedDate          a rdf:Property .
emp:seniority           a rdf:Property .
emp:remote              a rdf:Property .
emp:disabilityFriendly  a rdf:Property .
# --- intentionally "problematic" properties (for EaaS to flag) ---
emp:ageRangeMin         a rdf:Property ; rdfs:comment "Discriminatory proxy candidate"@en .
emp:ageRangeMax         a rdf:Property ; rdfs:comment "Discriminatory proxy candidate"@en .
emp:genderPreference    a rdf:Property ; rdfs:comment "Discriminatory proxy candidate"@en .
emp:nationalityReq      a rdf:Property ; rdfs:comment "Discriminatory proxy candidate"@en .

#################################################################
# Locations
#################################################################
emp:loc-rome      a emp:Location ; rdfs:label "Rome" .
emp:loc-milan     a emp:Location ; rdfs:label "Milan" .
emp:loc-laquila   a emp:Location ; rdfs:label "L'Aquila" .
emp:loc-naples    a emp:Location ; rdfs:label "Naples" .
emp:loc-turin     a emp:Location ; rdfs:label "Turin" .
emp:loc-bologna   a emp:Location ; rdfs:label "Bologna" .
emp:loc-remote    a emp:Location ; rdfs:label "Remote" .

#################################################################
# Sectors
#################################################################
emp:sec-it        a emp:Sector ; rdfs:label "Information Technology" .
emp:sec-finance   a emp:Sector ; rdfs:label "Finance" .
emp:sec-health    a emp:Sector ; rdfs:label "Healthcare" .
emp:sec-edu       a emp:Sector ; rdfs:label "Education" .
emp:sec-logistics a emp:Sector ; rdfs:label "Logistics" .

#################################################################
# Skills
#################################################################
emp:sk-java       a emp:Skill ; rdfs:label "Java" .
emp:sk-python     a emp:Skill ; rdfs:label "Python" .
emp:sk-sparql     a emp:Skill ; rdfs:label "SPARQL" .
emp:sk-react      a emp:Skill ; rdfs:label "React" .
emp:sk-sql        a emp:Skill ; rdfs:label "SQL" .
emp:sk-aws        a emp:Skill ; rdfs:label "AWS" .
emp:sk-docker     a emp:Skill ; rdfs:label "Docker" .
emp:sk-ml         a emp:Skill ; rdfs:label "Machine Learning" .
emp:sk-pm         a emp:Skill ; rdfs:label "Project Management" .
emp:sk-nursing    a emp:Skill ; rdfs:label "Nursing" .
emp:sk-teaching   a emp:Skill ; rdfs:label "Teaching" .
emp:sk-accounting a emp:Skill ; rdfs:label "Accounting" .

#################################################################
# Companies
#################################################################
emp:comp-acme       a emp:Company ; schema:name "Acme Tech"      ; emp:hasLocation emp:loc-milan .
emp:comp-medcare    a emp:Company ; schema:name "MedCare Italia" ; emp:hasLocation emp:loc-rome .
emp:comp-edusmart   a emp:Company ; schema:name "EduSmart"       ; emp:hasLocation emp:loc-bologna .
emp:comp-finhub     a emp:Company ; schema:name "FinHub"         ; emp:hasLocation emp:loc-milan .
emp:comp-logix      a emp:Company ; schema:name "Logix Express"  ; emp:hasLocation emp:loc-naples .
emp:comp-quantai    a emp:Company ; schema:name "QuantAI"        ; emp:hasLocation emp:loc-turin .
emp:comp-startuplab a emp:Company ; schema:name "StartupLab"     ; emp:hasLocation emp:loc-laquila .

